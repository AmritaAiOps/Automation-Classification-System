# Pharmacy MIS — Sudhamayi Enterprise Pvt. Ltd.
#
# One app lives here: pharmacy-mis-app (Node/Electron). Deliberate artifacts
# are NOT ignored: reference/ and DEMO/ are checked in on purpose as evidence
# of the mapping working.

# ---------------------------------------------------------------- secrets
# The Puppeteer half needs portal credentials, and a code-signing build needs a
# certificate. Nothing resembling either gets committed, ever.
.env
.env.*
!.env.example
*.pem
*.pfx
*.key
credentials.json
secrets.json

# ------------------------------------------------------------------- node
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# Everything the build makes on the way to the release.
# src/excel/template.js IS committed — it is generated, but the build needs it
# when the reference workbook is not present.
# assets/icon.ico is generated by tools/make-icon.js on every build.
pharmacy-mis-app/build/
pharmacy-mis-app/assets/icon.ico
pharmacy-mis-app/.chromium-cache/

# The release itself IS committed so the app can be downloaded straight from
# the repo: the exe (stored via Git LFS — see .gitattributes, it is >100 MB)
# and its checksum. Anything else the build leaves in dist/ stays ignored.
# `dist/*` (not `dist/`) so the negations below can take effect.
pharmacy-mis-app/dist/*
!pharmacy-mis-app/dist/Pharmacy-MIS.exe
!pharmacy-mis-app/dist/Pharmacy-MIS.exe.sha256

# ---------------------------------------------------------------- python
# Leftovers from the retired pharmacy-report-app (PyInstaller) prototype.
__pycache__/
*.py[cod]
*.spec

# -------------------------------------------------------- run/test output
# Master reports written into an archive tree during local runs. The one under
# DEMO/ is committed deliberately, so it is excluded from this rule.
Pharmacy-MIS/
!DEMO/Pharmacy-MIS/

# Half-written workbooks from an interrupted atomic save (master.js writes
# <target>.tmp-<pid> then renames).
*.tmp-*

# ------------------------------------------------------------------ excel
# Lock files Excel drops beside a workbook while it is open.
~$*.xls
~$*.xlsx
~$*.doc
~$*.docx

# --------------------------------------------------------------- os / ide
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
*.swp
*~
