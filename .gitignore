# Pharmacy Daily Report — Sudhamayi Enterprise Pvt. Ltd.
#
# Two apps live here (pharmacy-mis-app, Node; pharmacy-report-app, Python),
# so this covers both toolchains. Deliberate artifacts are NOT ignored:
# reference/, DEMO/ and the screenshot folders are checked in on purpose as
# evidence of the mapping working.

# ---------------------------------------------------------------- secrets
# The Puppeteer half needs portal credentials. Nothing resembling one gets
# committed, ever.
.env
.env.*
!.env.example
*.pem
*.pfx
*.key
credentials.json
secrets.json

# ------------------------------------------------------------------- node
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# Built exe and the SEA intermediates that produce it (tools/build.js).
# src/excel/template.js IS committed — it is generated, but the build needs it
# when the reference workbook is not present.
pharmacy-mis-app/dist/
pharmacy-mis-app/build/bundle.js
pharmacy-mis-app/build/sea.blob
pharmacy-mis-app/build/sea-config.json
pharmacy-mis-app/build/meta.json

# ----------------------------------------------------------------- python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller: build/ and dist/ are regenerated by build.py, and the .spec
# alongside them is written by that script rather than maintained by hand.
pharmacy-report-app/build/
pharmacy-report-app/dist/
*.spec

# -------------------------------------------------------- run/test output
# Throwaway output from test and smoke runs. The DEMO/ archive is kept.
pharmacy-report-app/exe-test/
pharmacy-report-app/test-run/

# Master reports written into an archive tree during local runs. The one under
# DEMO/ is committed deliberately, so it is excluded from this rule.
Pharmacy-MIS/
!DEMO/Pharmacy-MIS/

# Half-written workbooks from an interrupted atomic save (master.js writes
# <target>.tmp-<pid> then renames).
*.tmp-*

# ------------------------------------------------------------------ excel
# Lock files Excel drops beside a workbook while it is open.
~$*.xls
~$*.xlsx
~$*.doc
~$*.docx

# --------------------------------------------------------------- os / ide
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
*.swp
*~
